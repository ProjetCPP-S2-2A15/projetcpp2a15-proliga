         <property name="styleSheet">
          <string notr="true">QPushButton {
    background-color: #4CAF50; /* Match the green theme */
    color: #ffffff; /* White text */
    border-radius: 12px; /* Rounded corners */
    padding: 6px 12px;
    font: bold 10pt &quot;Segoe UI&quot;;
    border: 2px solid #2E7D32; /* Darker green border */
}

QPushButton:hover {
    background-color: #45A049; /* Slightly darker green when hovered */
}

QPushButton:pressed {
    background-color: #388E3C; /* Even darker green for click effect */
    border-style: inset; /* Makes the button appear pressed */
}

QPushButton:disabled {
    background-color: #BDBDBD; /* Gray out when disabled */
    color: #757575;
    border: 2px solid #9E9E9E;
}
</string>
