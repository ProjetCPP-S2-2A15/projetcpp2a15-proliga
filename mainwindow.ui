         <property name="styleSheet">
          <string notr="true">QTableWidget {
    background-color: #2C2F33; /* Dark gray background */
    color: #FFFFFF; /* White text */
    border: 2px solid #4CAF50; /* Green border */
    border-radius: 10px;
    gridline-color: #4CAF50; /* Green grid lines */
    font: 08pt &quot;Segoe UI&quot;;
}

QTableWidget::item {
    background-color: #2C2F33; /* Dark background */
    padding: 6px;
    border: none;
    color: #FFFFFF; /* White text */
}

QTableWidget::item:selected {
    background-color: #4CAF50; /* Green when selected */
    color: #000000; /* Black text on selection */
}

QHeaderView::section {
    background-color: #4CAF50; /* Green header */
    color: white;
    padding: 6px;
    border: 1px solid #2E7D32; /* Darker green border */
    font: bold 8pt &quot;Segoe UI&quot;;
}

QTableWidget QTableCornerButton::section {
    background-color: #4CAF50; /* Match header color */
    border: 2px solid #2E7D32;
}

QHeaderView::section:hover {
    background-color: #45A049; /* Slightly darker green on hover */
}

QTableWidget::item:hover {
    background-color: #388E3C; /* Dark green on hover */
}
</string>
