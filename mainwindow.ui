            <string notr="true">QTableWidget {
    border: 1px solid black;
    border-radius: 10px; /* Adjust for desired roundness */
    gridline-color: gray; /* Optional: Customize gridline color */
}

QHeaderView::section {
    background-color: black;
    color: white; /* Text color for header */
    padding: 4px; /* Adjust padding as needed */
    border: none; /* Remove default header border */
    border-bottom: 2px solid gray; /* Add a bottom border for separation */
}

QTableWidget::item {
    padding: 4px; /* Adjust padding for table items */
}

QTableWidget QTableCornerButton::section {
    background-color: black; /* Color for the corner button */
    border: none;
}

QTableWidget::QToolTip {
    background-color: #333; /* Dark background */
    color: #fff; /* White text */
    border: 1px solid #555; /* Slightly lighter border */
    padding: 5px; /* Add some padding */
    border-radius: 5px; /* Rounded corners */
    font-family: &quot;Segoe UI&quot;, &quot;Arial&quot;, sans-serif; /* Modern font */
    font-size: 11pt; /* Slightly larger font size */
    opacity: 0.9; /* Slightly transparent */
}</string>
