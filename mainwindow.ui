         <property name="styleSheet">
          <string notr="true">QSpinBox {
    background-color: #2C2F33; /* Dark background */
    color: #FFFFFF; /* White text */
    border: 2px solid #7289DA; /* Blue border */
    border-radius: 8px; /* Rounded corners */
    padding: 3px 12px;
    font-size: 12px;
    selection-background-color: rgba(0, 122, 204, 0.5); /* Blue highlight */
}

QSpinBox:hover {
    border: 2px solid #5DADE2; /* Lighter blue on hover */
}

QSpinBox:focus {
    border: 2px solid #00A8E8; /* Bright blue focus border */
    background-color: #1E2125; /* Slightly darker background */
    color: white;
}

/* Customize the up/down arrows */
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #2C2F33; /* Dark background */
    border: none;
    width: 18px; /* Adjust button size */
    height: 14px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #3B4E58; /* Slightly lighter hover effect */
}

QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background-color: #1E4C79; /* Deep blue when pressed */
}

QSpinBox::up-arrow, QSpinBox::down-arrow {
    width: 10px;
    height: 10px;
    image: url(:/icons/up-arrow.png); /* Replace with an actual arrow icon */
}

QSpinBox::down-arrow {
    image: url(:/icons/down-arrow.png); /* Replace with actual icon */
}
</string>
         </property>
